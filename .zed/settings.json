{
  "context_servers": {
    "postgres": {
      "source": "custom",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--net=host",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted",
      ],
      "env": {
        "DATABASE_URI": "postgresql://supabase_admin:1n1t-R00t!@localhost:5432/app",
      },
    },
  },
  "lsp": {
    "gopls": {
      "binary": {
        "ignore_system_version": true,
        "path": "bazel",
        "arguments": ["run", "--run_in_cwd", "@org_golang_x_tools_gopls//:gopls"],
      },
      "initialization_options": {
        "local": "github.com/prskr/supabase-operator",
        "buildFlags": ["-tags", "e2e"],
      },
    },
  },
}
