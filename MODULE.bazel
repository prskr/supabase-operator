"supabase-operator"

module(
    name = "de_icb4dc0_code_prskr_supabase-operator",
)

bazel_dep(
    name = "rules_go",
    version = "0.55.1",
)
bazel_dep(
    name = "gazelle",
    version = "0.44.0",
)
bazel_dep(
    name = "rules_oci",
    version = "2.2.6",
)
bazel_dep(
    name = "platforms",
    version = "1.0.0",
)
bazel_dep(
    name = "rules_pkg",
    version = "1.1.0",
)
bazel_dep(
    name = "aspect_bazel_lib",
    version = "2.19.4",
)
bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.2.0.2",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

include("//build:analyzers.MODULE.bazel")

supabase_compose = use_extension("//build:extensions.bzl", "supabase_compose")
use_repo(supabase_compose, "supabase_compose")

supabase_migrations = use_extension("//build:extensions.bzl", "supabase_migrations")
use_repo(supabase_migrations, "supabase_migrations")

supabase_init_scripts = use_extension("//build:extensions.bzl", "supabase_init_scripts")
use_repo(supabase_init_scripts, "supabase_init_scripts")

