    "com_github_onsi_gomega",
    "com_github_sivchari_containedctx",
    "com_github_stretchr_testify",
    "de_icb4dc0_code_prskr_bazel_golangci_lint_analyzers",
    "in_gopkg_yaml_v3",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_client_go",
