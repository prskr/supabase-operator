"supabase-operator"

module(
    name = "com_github_prskr_supabase-operator",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_lint", version = "2.3.0")
bazel_dep(name = "bazel_env.bzl", version = "0.7.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.2.1.2")
bazel_dep(name = "gazelle", version = "0.50.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "34.1")
bazel_dep(name = "rules_android", version = "0.7.1")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_multirun", version = "0.13.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:multitool.lock.json")
use_repo(multitool, "multitool")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base_nossl_debian12",
    digest = "sha256:a1922debbf4ff2cc245d7c0d1e2021cfcee35fe24afae7505aeec59f7e7802f6",
    image = "gcr.io/distroless/base-nossl-debian12",
    platforms = [
        "linux/amd64",
        "linux/arm/v7",
        "linux/arm64/v8",
        "linux/ppc64le",
        "linux/s390x",
    ],
)
use_repo(
    oci,
    "distroless_base_nossl_debian12",
    "distroless_base_nossl_debian12_linux_amd64",
    "distroless_base_nossl_debian12_linux_arm64_v8",
    "distroless_base_nossl_debian12_linux_arm_v7",
    "distroless_base_nossl_debian12_linux_ppc64le",
    "distroless_base_nossl_debian12_linux_s390x",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    experiments = ["jsonv2"],
    version = "1.26.2",
)
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# hack required because otherwise bazel tries to generate necessary proto files and is missing one
# instead of simply using the pre-generated files
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = [
        "gazelle:exclude **/*.proto",
        "gazelle:go_generate_proto false",
    ],
    path = "sigs.k8s.io/apiserver-network-proxy/konnectivity-client",
)

supabase_compose = use_repo_rule("//build/supabase:compose.bzl", "supabase_compose")

supabase_compose(
    name = "supabase_compose",
    sha256 = "0d55082034a80c7dd441b291589b98e73d9a7399df731af312b30d70b497a65d",
    version = "v1.26.03",
)

supabase_migrations = use_repo_rule("//build/supabase:migrations.bzl", "supabase_migrations")

supabase_migrations(
    name = "supabase_migrations",
    path_prefix = "migrations/db",
    sha256 = "2fbd23f511c296f4542e5298bf9e0a5f4cc80c636e0432f084f976cff21ecf02",
    version = "15.14.1.101",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "prometheus_crds",
    downloaded_file_path = "stripped-down-crds.yaml",
    sha256 = "c84e5a2e9e146c8f9a25dedf7dc563a9125679c70ee32d2c0d5486e50c0738b0",
    urls = ["https://github.com/prometheus-operator/prometheus-operator/releases/download/v0.90.1/stripped-down-crds.yaml"],
)

use_repo(
    go_deps,
    "com_github_alecthomas_assert_v2",
    "com_github_alecthomas_kong",
    "com_github_elastic_crd_ref_docs",
    "com_github_envoyproxy_go_control_plane",
    "com_github_envoyproxy_go_control_plane_envoy",
    "com_github_gkampitakis_go_snaps",
    "com_github_go_logr_logr",
    "com_github_gordonklaus_ineffassign",
    "com_github_jackc_pgx_v5",
    "com_github_kisielk_errcheck",
    "com_github_lasiar_canonicalheader",
    "com_github_lestrrat_go_jwx_v2",
    "com_github_onsi_ginkgo_v2",
    "com_github_onsi_gomega",
    "com_github_prometheus_operator_prometheus_operator_pkg_apis_monitoring",
    "com_github_sivchari_containedctx",
    "com_github_stretchr_testify",
    "de_icb4dc0_code_prskr_bazel_golangci_lint_analyzers",
    "in_gopkg_yaml_v3",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_client_go",
    "io_k8s_sigs_controller_runtime",
    "io_k8s_sigs_controller_runtime_tools_setup_envtest",
    "io_k8s_sigs_controller_tools",
    "io_k8s_sigs_kind",
    "io_k8s_sigs_kustomize_kustomize_v5",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_exp",
    "org_golang_x_tools",
    "org_golang_x_tools_gopls",
    "org_uber_go_nilaway",
    "org_uber_go_zap",
)
