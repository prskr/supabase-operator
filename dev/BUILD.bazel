load("@rules_multirun//:defs.bzl", "command", "multirun")
load("@rules_oci//oci:defs.bzl", "oci_push")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//build/k8s:kubectl.bzl", "kubectl_apply")

sh_binary(
    name = "start_cluster",
    srcs = ["setup_dev_cluster.sh"],
    data = [
        "cluster.yaml",
        "dex_config.yaml",
        "@io_k8s_sigs_kind//:kind",
        "@multitool//tools/kubectl",
    ],
    env = {
        # rlocationpath evaluates exactly to what the rlocation bash function needs
        "KIND_BIN": "$(rlocationpath @io_k8s_sigs_kind//:kind)",
        "KUBECTL_BIN": "$(rlocationpath @multitool//tools/kubectl:kubectl)",
        "CLUSTER_CONFIG": "$(rlocationpath cluster.yaml)",
        "DEX_IDP_CONFIG": "$(rlocationpath dex_config.yaml)",
    },
    deps = ["@rules_shell//shell/runfiles"],
)

sh_binary(
    name = "teardown_cluster",
    srcs = ["teardown_dev_cluster.sh"],
    data = [
        "@io_k8s_sigs_kind//:kind",
    ],
    env = {
        "KIND_BIN": "$(rlocationpath @io_k8s_sigs_kind//:kind)",
    },
    deps = ["@rules_shell//shell/runfiles"],
)

sh_binary(
    name = "generate_crd_code",
    srcs = ["generate_crd_code.sh"],
    data = [
        "//:crd-docs.yaml",
        "//api/v1alpha1:api-types",
        "//dev/templates",
        "//hack:boilerplate_go",
        "//internal/controller:reconciler_src",
        "@com_github_elastic_crd_ref_docs//:crd-ref-docs",
        "@io_k8s_sigs_controller_tools//cmd/controller-gen",
        "@rules_go//go",
    ],
    env = {
        "API_TYPES": "$(locations //api/v1alpha1:api-types)",
        "CONTROLLER_GEN": "$(rlocationpath @io_k8s_sigs_controller_tools//cmd/controller-gen)",
        "CRD_REF_DOCS": "$(rlocationpath @com_github_elastic_crd_ref_docs//:crd-ref-docs)",
    },
    deps = [
        "@rules_shell//shell/runfiles",
    ],
)

genrule(
    name = "dev-manifest",
    srcs = [
        "//:image_arm64.digest",
        "//config:all",
    ],
    outs = ["manifests.yaml"],
    cmd = """
    image_digest=`cat ./$(execpath //:image_arm64.digest)`
    cd config/dev
    ../../$(execpath @io_k8s_sigs_kustomize_kustomize_v5//:v5) edit set image "controller=localhost:5005/supabase-operator:latest@$$image_digest"
    cd ../../
    $(execpath @io_k8s_sigs_kustomize_kustomize_v5//:v5) build ./config/dev > $@
    """,
    local = True,
    tools = ["@io_k8s_sigs_kustomize_kustomize_v5//:v5"],
)

kubectl_apply(
    name = "apply-dev-manifest",
    context = "kind-supabase-operator-debug",
    kubectl = "@multitool//tools/kubectl:kubectl",
    manifest = ":dev-manifest",
)

oci_push(
    name = "push_local",
    image = "//:image_arm64",
    remote_tags = "//:image_arm64.digest",
    repository = "localhost:5005/supabase-operator",
)

command(
    name = "apply_kustomization",
    command = ":apply-dev-manifest",
)

command(
    name = "push_controller_image",
    command = ":push_local",
)

multirun(
    name = "dev",
    commands = [
        ":apply_kustomization",
        ":push_controller_image",
    ],
    jobs = 0,
)
