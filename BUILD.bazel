# gazelle:proto disable_global

load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "nogo")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

gazelle(
    name = "gazelle",
    extra_args = [
        "-mode=fix",
        "-proto=disable_global",
        "-strict=true",
    ],
)

buildifier(
    name = "fmt",
    exclude_patterns = [
        "./.git/*",
        "./.ijwb/*",
    ],
    lint_mode = "warn",
)

ARCHS = [
    "arm64",
    "amd64",
]

nogo(
    name = "nogo",
    config = ".nogo.json",
    vet = True,
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_gordonklaus_ineffassign//pkg/ineffassign",
        "@com_github_kisielk_errcheck//errcheck",
        "@com_github_lasiar_canonicalheader//:canonicalheader",
        "@com_github_sivchari_containedctx//:containedctx",
        "@de_icb4dc0_code_prskr_bazel_golangci_lint_analyzers//contextcheck",
        "@de_icb4dc0_code_prskr_bazel_golangci_lint_analyzers//copyloopvar",
        "@de_icb4dc0_code_prskr_bazel_golangci_lint_analyzers//err113",
        "@org_uber_go_nilaway//:nilaway",
    ],
)

# keep
go_binary(
    name = "supabase-operator",
    embed = ["//cmd:cmd_lib"],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

[
    go_cross_binary(
        name = "supabase-operator_" + arch,
        platform = ":linux_" + arch,
        target = ":supabase-operator",
    )
    for arch in ARCHS
]

[
    pkg_files(
        name = "app_files_" + arch,
        srcs = [":supabase-operator_" + arch],
        attributes = pkg_attributes("755"),
        renames = {
            "supabase-operator_" + arch: "supabase-operator",
        },
    )
    for arch in ARCHS
]

[
    pkg_tar(
        name = "app_layer_" + arch,
        srcs = [":app_files_" + arch],
    )
    for arch in ARCHS
]

[
    oci_image(
        name = "image_" + arch,
        base = "@distroless_base_nossl_debian12",
        entrypoint = ["/supabase-operator"],
        tars = [":app_layer_" + arch],
        user = "65534:65534",
        visibility = ["//visibility:public"],
    )
    for arch in ARCHS
]

expand_template(
    name = "stamped",
    out = "_stamped.tags.txt",
    stamp_substitutions = {"dev": "{{STABLE_GIT_TAG}}"},
    template = ["dev"],
)

oci_image_index(
    name = "image_multiarch",
    images = [":image_" + arch for arch in ARCHS],
)

oci_push(
    name = "push",
    image = ":image_multiarch",
    remote_tags = ":stamped",
    repository = "registry.icb4dc0.de/supabase-operator/controller",
)

oci_load(
    name = "load",
    image = ":image_arm64",
    repo_tags = ["supabase-operator:latest"],
)
